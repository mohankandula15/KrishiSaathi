# KrishiSaathi Environment Configuration

# Frontend (Vite) Configuration
# API base URL pointing to the FastAPI backend (e.g. http://localhost:8000/api or https://your-backend.onrender.com/api)
VITE_API_URL=http://localhost:8000/api

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# JWT Authentication
JWT_SECRET=krishisaathi_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_STORAGE_BUCKET=soil-reports

# Google Gemini API Configuration (for KRISHISAATHI AI Voice & Agronomy Engine)
GEMINI_API_KEY=your-google-gemini-api-key

# Optional: Direct PostgreSQL Connection URI (if connecting via asyncpg/psycopg)
# DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres
